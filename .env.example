# No API key is needed for the existing guest features.
# Optional local server configuration (pass in your shell; no dotenv loader).
PORT=3000
HOST=127.0.0.1

# ── Supabase (multi-student cloud sync) ───────────────────────────────────────
# Required only for cloud-sync/sign-in features. Guest mode works without these.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<public-anon-key>
# Never put the service-role key in a browser-visible variable.
# SERVICE_ROLE_KEY goes only in Supabase Edge Function secrets (server-side).

# ── Compiler service (Smart Lab — C/C++/Java via Compiler Explorer) ───────────
# The app uses the public Compiler Explorer API by default (rate-limited).
# Point at a self-hosted instance to lift limits:
# COMPILER_EXPLORER_URL=https://your-godbolt-instance.example.com

# ── Cloudflare Sites (optional publishing workflow) ───────────────────────────
# Only set when packaging for an existing Sites project:
# SITES_PROJECT_ID=
